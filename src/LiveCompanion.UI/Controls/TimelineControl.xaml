<UserControl x:Class="LiveCompanion.UI.Controls.TimelineControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinHeight="80"
             Background="#181825">

    <Border Background="#1E1E2E" CornerRadius="12" Padding="14,10"
            BorderBrush="#2A2A3C" BorderThickness="1">
        <DockPanel>
            <!-- Header -->
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                <TextBlock Text="TIMELINE"
                           Foreground="#7F849C" FontSize="10" FontWeight="Bold"
                           VerticalAlignment="Center" />

                <!-- Current section info -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock x:Name="SectionInfoText"
                               Foreground="#89B4FA" FontSize="12" FontWeight="SemiBold"
                               Margin="0,0,16,0" VerticalAlignment="Center" />
                    <TextBlock x:Name="TempoInfoText"
                               Foreground="#A6ADC8" FontSize="11"
                               Margin="0,0,16,0" VerticalAlignment="Center" />
                    <TextBlock x:Name="PositionInfoText"
                               Foreground="#CDD6F4" FontSize="12" FontFamily="Consolas"
                               VerticalAlignment="Center" />
                </StackPanel>
            </DockPanel>

            <!-- Zoom -->
            <DockPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                <TextBlock Text="Zoom" Foreground="#45475A" FontSize="10"
                           VerticalAlignment="Center" Margin="0,0,8,0" />
                <Slider x:Name="ZoomSlider"
                        Minimum="20" Maximum="80" Value="40"
                        Width="120"
                        VerticalAlignment="Center"
                        ValueChanged="ZoomSlider_ValueChanged" />
            </DockPanel>

            <!-- Timeline canvas -->
            <Border Background="#11111B" CornerRadius="8" ClipToBounds="True">
                <Canvas x:Name="TimelineCanvas"
                        Height="48"
                        SizeChanged="TimelineCanvas_SizeChanged" />
            </Border>
        </DockPanel>
    </Border>
</UserControl>
