<Window x:Class="LiveCompanion.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:LiveCompanion.UI.Views"
        xmlns:vm="clr-namespace:LiveCompanion.UI.ViewModels"
        Title="Live Companion" Height="700" Width="1100"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:LiveViewModel}">
            <views:LiveView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:EditorViewModel}">
            <views:EditorView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:LibraryViewModel}">
            <views:LibraryView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ConfigViewModel}">
            <views:ConfigView />
        </DataTemplate>

        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Foreground" Value="#AAAACC" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="Transparent"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"
                                              TextBlock.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#252538" />
                                <Setter Property="Foreground" Value="#DDDDEE" />
                            </Trigger>
                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2D2D48" />
                                <Setter Property="Foreground" Value="White" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="#1E1E2E" Padding="8">
            <StackPanel>
                <TextBlock Text="Live Companion"
                           Foreground="White"
                           FontSize="18"
                           FontWeight="Bold"
                           Margin="0,8,0,24"
                           HorizontalAlignment="Center" />

                <Button Content="Live"
                        Command="{Binding NavigateCommand}"
                        CommandParameter="Live"
                        Tag="{Binding IsLiveActive}"
                        Style="{StaticResource NavButtonStyle}"
                        Margin="0,2" />
                <Button Content="Editor"
                        Command="{Binding NavigateCommand}"
                        CommandParameter="Editor"
                        Tag="{Binding IsEditorActive}"
                        Style="{StaticResource NavButtonStyle}"
                        Margin="0,2" />
                <Button Content="Library"
                        Command="{Binding NavigateCommand}"
                        CommandParameter="Library"
                        Tag="{Binding IsLibraryActive}"
                        Style="{StaticResource NavButtonStyle}"
                        Margin="0,2" />
                <Button Content="Config"
                        Command="{Binding NavigateCommand}"
                        CommandParameter="Config"
                        Tag="{Binding IsConfigActive}"
                        Style="{StaticResource NavButtonStyle}"
                        Margin="0,2" />
            </StackPanel>
        </Border>

        <!-- Content -->
        <ContentControl Grid.Column="1"
                         Content="{Binding CurrentView}"
                         Margin="16" />
    </Grid>
</Window>
