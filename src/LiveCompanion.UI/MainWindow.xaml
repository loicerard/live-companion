<Window x:Class="LiveCompanion.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:LiveCompanion.UI.Views"
        xmlns:vm="clr-namespace:LiveCompanion.UI.ViewModels"
        Title="Live Companion" Height="700" Width="1100"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:LiveViewModel}">
            <views:LiveView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:EditorViewModel}">
            <views:EditorView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:LibraryViewModel}">
            <views:LibraryView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ConfigViewModel}">
            <views:ConfigView />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="#1E1E2E" Padding="8">
            <StackPanel>
                <TextBlock Text="Live Companion"
                           Foreground="White"
                           FontSize="18"
                           FontWeight="Bold"
                           Margin="0,8,0,24"
                           HorizontalAlignment="Center" />

                <Button Content="Live"
                        Command="{Binding NavigateCommand}"
                        CommandParameter="Live"
                        Margin="0,2" Padding="12,8" />
                <Button Content="Editor"
                        Command="{Binding NavigateCommand}"
                        CommandParameter="Editor"
                        Margin="0,2" Padding="12,8" />
                <Button Content="Library"
                        Command="{Binding NavigateCommand}"
                        CommandParameter="Library"
                        Margin="0,2" Padding="12,8" />
                <Button Content="Config"
                        Command="{Binding NavigateCommand}"
                        CommandParameter="Config"
                        Margin="0,2" Padding="12,8" />
            </StackPanel>
        </Border>

        <!-- Content -->
        <ContentControl Grid.Column="1"
                         Content="{Binding CurrentView}"
                         Margin="16" />
    </Grid>
</Window>
