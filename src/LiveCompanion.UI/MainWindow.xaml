<Window x:Class="LiveCompanion.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:LiveCompanion.UI.Views"
        xmlns:vm="clr-namespace:LiveCompanion.UI.ViewModels"
        Title="Live Companion" Height="700" Width="1100"
        WindowStartupLocation="CenterScreen"
        Background="#14141F">

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:LiveViewModel}">
            <views:LiveView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:EditorViewModel}">
            <views:EditorView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:LibraryViewModel}">
            <views:LibraryView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ConfigViewModel}">
            <views:ConfigView />
        </DataTemplate>

        <!-- Navigation button with left accent bar -->
        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="#6C7086" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <!-- Left accent bar -->
                            <Border x:Name="accentBar"
                                    Width="3"
                                    HorizontalAlignment="Left"
                                    CornerRadius="0,2,2,0"
                                    Background="Transparent"
                                    Margin="0,4" />
                            <!-- Content area -->
                            <Border x:Name="border"
                                    Background="Transparent"
                                    CornerRadius="8"
                                    Padding="20,12,16,12"
                                    Margin="6,0,8,0">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="Center"
                                                  TextBlock.Foreground="{TemplateBinding Foreground}" />
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1A1A2E" />
                                <Setter Property="Foreground" Value="#BAC2DE" />
                            </Trigger>
                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="True">
                                <Setter TargetName="accentBar" Property="Background" Value="#89B4FA" />
                                <Setter TargetName="border" Property="Background" Value="#1A1A2E" />
                                <Setter Property="Foreground" Value="#CDD6F4" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="180" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="#16161E">
            <DockPanel>
                <!-- App title -->
                <StackPanel DockPanel.Dock="Top" Margin="16,20,16,28">
                    <TextBlock Text="Live"
                               Foreground="#CDD6F4"
                               FontSize="20"
                               FontWeight="Bold" />
                    <TextBlock Text="Companion"
                               Foreground="#89B4FA"
                               FontSize="20"
                               FontWeight="Light" />
                </StackPanel>

                <!-- Navigation -->
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="NAVIGATION"
                               Foreground="#45475A"
                               FontSize="9"
                               FontWeight="Bold"
                               Margin="20,0,0,8" />

                    <Button Content="Live"
                            Command="{Binding NavigateCommand}"
                            CommandParameter="Live"
                            Tag="{Binding IsLiveActive}"
                            Style="{StaticResource NavButtonStyle}" />
                    <Button Content="Editor"
                            Command="{Binding NavigateCommand}"
                            CommandParameter="Editor"
                            Tag="{Binding IsEditorActive}"
                            Style="{StaticResource NavButtonStyle}" />
                    <Button Content="Library"
                            Command="{Binding NavigateCommand}"
                            CommandParameter="Library"
                            Tag="{Binding IsLibraryActive}"
                            Style="{StaticResource NavButtonStyle}" />
                    <Button Content="Config"
                            Command="{Binding NavigateCommand}"
                            CommandParameter="Config"
                            Tag="{Binding IsConfigActive}"
                            Style="{StaticResource NavButtonStyle}" />
                </StackPanel>

                <!-- Spacer -->
                <Border />
            </DockPanel>
        </Border>

        <!-- Separator line -->
        <Border Grid.Column="0"
                HorizontalAlignment="Right"
                Width="1"
                Background="#1E1E2E" />

        <!-- Content -->
        <Border Grid.Column="1" Background="#181825">
            <ContentControl Content="{Binding CurrentView}"
                            Margin="0" />
        </Border>

        <!-- Loading overlay -->
        <Border Grid.ColumnSpan="2"
                Background="#E6141420"
                Visibility="{Binding IsInitializing, Converter={StaticResource BoolToVisibility}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="Initialisation audio..."
                           Foreground="#CDD6F4"
                           FontSize="18"
                           FontWeight="Medium"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,20" />
                <ProgressBar IsIndeterminate="True"
                             Width="240" Height="3"
                             Foreground="#89B4FA" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
