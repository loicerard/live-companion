<UserControl x:Class="LiveCompanion.UI.Views.LiveView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:LiveCompanion.UI.Controls"
             Background="#181825"
             Focusable="True">

    <UserControl.InputBindings>
        <KeyBinding Key="Space" Command="{Binding PlayCommand}" />
        <KeyBinding Key="P" Command="{Binding PauseCommand}" />
        <KeyBinding Key="Escape" Command="{Binding StopCommand}" />
        <KeyBinding Key="N" Command="{Binding NextSectionCommand}" />
        <KeyBinding Key="Left" Modifiers="Ctrl" Command="{Binding PreviousSongCommand}" />
        <KeyBinding Key="Right" Modifiers="Ctrl" Command="{Binding NextSongCommand}" />
    </UserControl.InputBindings>

    <UserControl.Resources>
        <!-- Style bouton transport -->
        <Style x:Key="TransportButtonStyle" TargetType="Button">
            <Setter Property="MinWidth" Value="100" />
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#CDD6F4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="4,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="#313244"
                                CornerRadius="8"
                                Padding="16,8"
                                BorderBrush="#45475A"
                                BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#45475A" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style carte (panneau info) -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="#1E1E2E" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="20,16" />
            <Setter Property="Margin" Value="0,6" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Morceau en cours + navigation -->
        <Border Grid.Row="0"
                Background="#1E1E2E"
                CornerRadius="10"
                Padding="16,10"
                Margin="0,0,0,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Bouton Previous -->
                <Button Grid.Column="0"
                        Content="&#x25C0;"
                        Command="{Binding PreviousSongCommand}"
                        ToolTip="Morceau précédent"
                        FontSize="14"
                        Foreground="#CDD6F4"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand"
                        Padding="8,4"
                        VerticalAlignment="Center" />

                <!-- Titre du morceau -->
                <TextBlock Grid.Column="1"
                           Text="{Binding SongTitle}"
                           Foreground="White"
                           FontSize="20"
                           FontWeight="Bold"
                           VerticalAlignment="Center"
                           Margin="8,0" />

                <!-- Position (n / total) -->
                <TextBlock Grid.Column="2"
                           Text="{Binding SongPositionDisplay}"
                           Foreground="#6C7086"
                           FontSize="14"
                           VerticalAlignment="Center"
                           Margin="8,0" />

                <!-- Bouton Next -->
                <Button Grid.Column="3"
                        Content="&#x25B6;"
                        Command="{Binding NextSongCommand}"
                        ToolTip="Morceau suivant"
                        FontSize="14"
                        Foreground="#CDD6F4"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand"
                        Padding="8,4"
                        VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- Section actuelle -->
        <Border Grid.Row="1" Style="{StaticResource CardStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.ColumnSpan="3"
                           Text="SECTION ACTUELLE"
                           Foreground="#6C7086"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Margin="0,0,0,6" />

                <TextBlock Grid.Row="1" Grid.Column="0"
                           Text="{Binding CurrentSectionName}"
                           Foreground="White"
                           FontSize="28"
                           FontWeight="Bold" />

                <TextBlock Grid.Row="1" Grid.Column="1"
                           Text="{Binding Tempo, StringFormat={}{0:0} BPM}"
                           Foreground="#A6ADC8"
                           FontSize="16"
                           FontWeight="Medium"
                           VerticalAlignment="Bottom"
                           Margin="16,0" />

                <Border Grid.Row="1" Grid.Column="2"
                        Background="#313244"
                        CornerRadius="6"
                        Padding="10,4"
                        VerticalAlignment="Bottom">
                    <TextBlock Text="{Binding TimeSignatureDisplay}"
                               Foreground="#CDD6F4"
                               FontSize="16"
                               FontWeight="SemiBold" />
                </Border>
            </Grid>
        </Border>

        <!-- Section suivante -->
        <Border Grid.Row="2" Style="{StaticResource CardStyle}">
            <StackPanel>
                <TextBlock Text="SECTION SUIVANTE"
                           Foreground="#6C7086"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Margin="0,0,0,6" />

                <TextBlock Text="{Binding NextSectionName}"
                           Foreground="#A6ADC8"
                           FontSize="20"
                           FontWeight="Medium" />
            </StackPanel>
        </Border>

        <!-- Position (mesure : temps) -->
        <Border Grid.Row="3" Style="{StaticResource CardStyle}">
            <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="POSITION"
                           Foreground="#6C7086"
                           FontSize="11"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,8" />

                <TextBlock Text="{Binding PositionDisplay}"
                           Foreground="White"
                           FontSize="48"
                           FontWeight="Bold"
                           FontFamily="Consolas"
                           HorizontalAlignment="Center" />

                <TextBlock Text="mesure : temps"
                           Foreground="#585B70"
                           FontSize="11"
                           HorizontalAlignment="Center"
                           Margin="0,4,0,0" />
            </StackPanel>
        </Border>

        <!-- Timeline (#17) -->
        <controls:TimelineControl Grid.Row="4"
                                  Sections="{Binding TimelineSections}"
                                  CurrentSectionIndex="{Binding TimelineSectionIndex}"
                                  CurrentBar="{Binding TimelineBar}"
                                  CurrentBeat="{Binding TimelineBeat}"
                                  Margin="0,6" />

        <!-- Transport controls -->
        <Border Grid.Row="5" Style="{StaticResource CardStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Boutons transport (centrés) -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center">

                    <!-- Play -->
                    <Button Command="{Binding PlayCommand}"
                            ToolTip="Play (Space)"
                            Style="{StaticResource TransportButtonStyle}">
                        <Button.Content>
                            <TextBlock>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="&#x25B6;  Play" />
                                        <Setter Property="Foreground" Value="#CDD6F4" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DataContext.IsPlaying,
                                                RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                                <Setter Property="Foreground" Value="#A6E3A1" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Button.Content>
                    </Button>

                    <!-- Pause -->
                    <Button Command="{Binding PauseCommand}"
                            ToolTip="Pause (P)"
                            Style="{StaticResource TransportButtonStyle}">
                        <Button.Content>
                            <TextBlock>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="&#x23F8;  Pause" />
                                        <Setter Property="Foreground" Value="#CDD6F4" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DataContext.IsPaused,
                                                RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                                <Setter Property="Foreground" Value="#F9E2AF" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Button.Content>
                    </Button>

                    <!-- Stop -->
                    <Button Content="&#x23F9;  Stop"
                            Command="{Binding StopCommand}"
                            ToolTip="Stop (Esc)"
                            Style="{StaticResource TransportButtonStyle}" />

                    <!-- Next Section + indicateur de transition -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="10" Height="10"
                                 Margin="8,0,4,0"
                                 VerticalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="#F38BA8" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CanTransition}" Value="True">
                                            <Setter Property="Fill" Value="#A6E3A1" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <Button Content="&#x23ED;  Next"
                                Command="{Binding NextSectionCommand}"
                                ToolTip="Next Section (N)"
                                Style="{StaticResource TransportButtonStyle}" />
                    </StackPanel>
                </StackPanel>

                <!-- Indicateur d'état transport -->
                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <Ellipse Width="10" Height="10"
                             Margin="0,0,8,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="#585B70" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                        <Setter Property="Fill" Value="#A6E3A1" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsPaused}" Value="True">
                                        <Setter Property="Fill" Value="#F9E2AF" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock VerticalAlignment="Center"
                               FontSize="13">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="Stopped" />
                                <Setter Property="Foreground" Value="#585B70" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                        <Setter Property="Text" Value="Playing" />
                                        <Setter Property="Foreground" Value="#A6E3A1" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsPaused}" Value="True">
                                        <Setter Property="Text" Value="Paused" />
                                        <Setter Property="Foreground" Value="#F9E2AF" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
