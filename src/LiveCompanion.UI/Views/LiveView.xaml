<UserControl x:Class="LiveCompanion.UI.Views.LiveView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:LiveCompanion.UI.Controls"
             xmlns:converters="clr-namespace:LiveCompanion.UI.Converters"
             Background="#181825"
             Focusable="True">

    <UserControl.InputBindings>
        <KeyBinding Key="Space" Command="{Binding PlayCommand}" />
        <KeyBinding Key="P" Command="{Binding PauseCommand}" />
        <KeyBinding Key="Escape" Command="{Binding StopCommand}" />
        <KeyBinding Key="N" Command="{Binding NextSectionCommand}" />
        <KeyBinding Key="Left" Modifiers="Ctrl" Command="{Binding PreviousSongCommand}" />
        <KeyBinding Key="Right" Modifiers="Ctrl" Command="{Binding NextSongCommand}" />
    </UserControl.InputBindings>

    <UserControl.Resources>
        <converters:LevelToHeightConverter x:Key="LevelToHeightConverter" />

        <!-- Transport button -->
        <Style x:Key="TransportButtonStyle" TargetType="Button">
            <Setter Property="MinWidth" Value="110" />
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#CDD6F4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="4,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="#262637"
                                CornerRadius="10"
                                Padding="18,10"
                                BorderBrush="#313244"
                                BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#313244" />
                                <Setter TargetName="border" Property="BorderBrush" Value="#45475A" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Song header + navigation -->
        <Border Grid.Row="0"
                Background="#1E1E2E"
                CornerRadius="12"
                Padding="20,14"
                Margin="0,0,0,8"
                BorderBrush="#2A2A3C"
                BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Content="&#x25C0;"
                        Command="{Binding PreviousSongCommand}"
                        ToolTip="Morceau précédent"
                        FontSize="12"
                        Foreground="#6C7086"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand"
                        Padding="8,4"
                        VerticalAlignment="Center" />

                <TextBlock Grid.Column="1"
                           Text="{Binding SongTitle}"
                           Foreground="#CDD6F4"
                           FontSize="22"
                           FontWeight="Bold"
                           VerticalAlignment="Center"
                           Margin="12,0" />

                <TextBlock Grid.Column="2"
                           Text="{Binding SongPositionDisplay}"
                           Foreground="#585B70"
                           FontSize="13"
                           VerticalAlignment="Center"
                           Margin="8,0" />

                <Button Grid.Column="3"
                        Content="&#x25B6;"
                        Command="{Binding NextSongCommand}"
                        ToolTip="Morceau suivant"
                        FontSize="12"
                        Foreground="#6C7086"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand"
                        Padding="8,4"
                        VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- Current section + Next section side by side -->
        <Grid Grid.Row="1" Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="Auto" MinWidth="220" />
            </Grid.ColumnDefinitions>

            <!-- Current section -->
            <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.ColumnSpan="3"
                               Text="SECTION ACTUELLE"
                               Foreground="#7F849C"
                               FontSize="10"
                               FontWeight="Bold"
                               Margin="0,0,0,8" />

                    <TextBlock Grid.Row="1" Grid.Column="0"
                               Text="{Binding CurrentSectionName}"
                               Foreground="White"
                               FontSize="30"
                               FontWeight="Bold" />

                    <TextBlock Grid.Row="1" Grid.Column="1"
                               Text="{Binding Tempo, StringFormat={}{0:0} BPM}"
                               Foreground="#A6ADC8"
                               FontSize="15"
                               FontWeight="Medium"
                               VerticalAlignment="Bottom"
                               Margin="20,0" />

                    <Border Grid.Row="1" Grid.Column="2"
                            Background="#262637"
                            CornerRadius="8"
                            Padding="12,6"
                            VerticalAlignment="Bottom">
                        <TextBlock Text="{Binding TimeSignatureDisplay}"
                                   Foreground="#BAC2DE"
                                   FontSize="15"
                                   FontWeight="SemiBold" />
                    </Border>
                </Grid>
            </Border>

            <!-- Next section -->
            <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="SECTION SUIVANTE"
                               Foreground="#7F849C"
                               FontSize="10"
                               FontWeight="Bold"
                               Margin="0,0,0,8" />

                    <TextBlock Text="{Binding NextSectionName}"
                               Foreground="#A6ADC8"
                               FontSize="20"
                               FontWeight="Medium" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Position (bar : beat) -->
        <Border Grid.Row="3" Style="{StaticResource CardStyle}" Padding="20,20">
            <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="POSITION"
                           Foreground="#7F849C"
                           FontSize="10"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,10" />

                <TextBlock Text="{Binding PositionDisplay}"
                           Foreground="White"
                           FontSize="52"
                           FontWeight="Bold"
                           FontFamily="Consolas"
                           HorizontalAlignment="Center" />

                <TextBlock Text="mesure : temps"
                           Foreground="#45475A"
                           FontSize="11"
                           HorizontalAlignment="Center"
                           Margin="0,6,0,0" />
            </StackPanel>
        </Border>

        <!-- Timeline -->
        <controls:TimelineControl Grid.Row="4"
                                  Sections="{Binding TimelineSections}"
                                  CurrentSectionIndex="{Binding TimelineSectionIndex}"
                                  CurrentBar="{Binding TimelineBar}"
                                  CurrentBeat="{Binding TimelineBeat}"
                                  Margin="0,6" />

        <!-- VU meters -->
        <Border Grid.Row="5" Style="{StaticResource CardStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Bus Main -->
                <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                    <TextBlock Text="MAIN"
                               Foreground="#7F849C"
                               FontSize="10"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,8" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Height="60">
                        <Border Width="16" Height="60" Background="#262637" CornerRadius="4" Margin="2,0">
                            <Border CornerRadius="4" VerticalAlignment="Bottom"
                                    Height="{Binding MainLevelLeft, Converter={StaticResource LevelToHeightConverter}}">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
                                        <GradientStop Color="#A6E3A1" Offset="0.0" />
                                        <GradientStop Color="#F9E2AF" Offset="0.7" />
                                        <GradientStop Color="#F38BA8" Offset="1.0" />
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                        </Border>
                        <Border Width="16" Height="60" Background="#262637" CornerRadius="4" Margin="2,0">
                            <Border CornerRadius="4" VerticalAlignment="Bottom"
                                    Height="{Binding MainLevelRight, Converter={StaticResource LevelToHeightConverter}}">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
                                        <GradientStop Color="#A6E3A1" Offset="0.0" />
                                        <GradientStop Color="#F9E2AF" Offset="0.7" />
                                        <GradientStop Color="#F38BA8" Offset="1.0" />
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                        </Border>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
                        <TextBlock Text="L" Foreground="#45475A" FontSize="10" Margin="5,0" />
                        <TextBlock Text="R" Foreground="#45475A" FontSize="10" Margin="5,0" />
                    </StackPanel>
                </StackPanel>

                <!-- Bus Click -->
                <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                    <TextBlock Text="CLICK"
                               Foreground="#7F849C"
                               FontSize="10"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,8" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Height="60">
                        <Border Width="16" Height="60" Background="#262637" CornerRadius="4" Margin="2,0">
                            <Border CornerRadius="4" VerticalAlignment="Bottom"
                                    Height="{Binding ClickLevelLeft, Converter={StaticResource LevelToHeightConverter}}">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
                                        <GradientStop Color="#A6E3A1" Offset="0.0" />
                                        <GradientStop Color="#F9E2AF" Offset="0.7" />
                                        <GradientStop Color="#F38BA8" Offset="1.0" />
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                        </Border>
                        <Border Width="16" Height="60" Background="#262637" CornerRadius="4" Margin="2,0">
                            <Border CornerRadius="4" VerticalAlignment="Bottom"
                                    Height="{Binding ClickLevelRight, Converter={StaticResource LevelToHeightConverter}}">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
                                        <GradientStop Color="#A6E3A1" Offset="0.0" />
                                        <GradientStop Color="#F9E2AF" Offset="0.7" />
                                        <GradientStop Color="#F38BA8" Offset="1.0" />
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                        </Border>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
                        <TextBlock Text="L" Foreground="#45475A" FontSize="10" Margin="5,0" />
                        <TextBlock Text="R" Foreground="#45475A" FontSize="10" Margin="5,0" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Transport controls -->
        <Border Grid.Row="6" Style="{StaticResource CardStyle}" Padding="20,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Transport buttons -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center">

                    <!-- Play -->
                    <Button Command="{Binding PlayCommand}"
                            ToolTip="Play (Space)"
                            Style="{StaticResource TransportButtonStyle}">
                        <Button.Content>
                            <TextBlock>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="&#x25B6;  Play" />
                                        <Setter Property="Foreground" Value="#CDD6F4" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DataContext.IsPlaying,
                                                RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                                <Setter Property="Foreground" Value="#A6E3A1" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Button.Content>
                    </Button>

                    <!-- Pause -->
                    <Button Command="{Binding PauseCommand}"
                            ToolTip="Pause (P)"
                            Style="{StaticResource TransportButtonStyle}">
                        <Button.Content>
                            <TextBlock>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="&#x23F8;  Pause" />
                                        <Setter Property="Foreground" Value="#CDD6F4" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DataContext.IsPaused,
                                                RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                                <Setter Property="Foreground" Value="#F9E2AF" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Button.Content>
                    </Button>

                    <!-- Stop -->
                    <Button Content="&#x23F9;  Stop"
                            Command="{Binding StopCommand}"
                            ToolTip="Stop (Esc)"
                            Style="{StaticResource TransportButtonStyle}" />

                    <!-- Next Section + transition indicator -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="8" Height="8"
                                 Margin="10,0,6,0"
                                 VerticalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="#F38BA8" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CanTransition}" Value="True">
                                            <Setter Property="Fill" Value="#A6E3A1" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <Button Content="&#x23ED;  Next"
                                Command="{Binding NextSectionCommand}"
                                ToolTip="Next Section (N)"
                                Style="{StaticResource TransportButtonStyle}" />
                    </StackPanel>
                </StackPanel>

                <!-- Transport state indicator -->
                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8"
                             Margin="0,0,8,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="#45475A" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                        <Setter Property="Fill" Value="#A6E3A1" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsPaused}" Value="True">
                                        <Setter Property="Fill" Value="#F9E2AF" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock VerticalAlignment="Center"
                               FontSize="12">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="Stopped" />
                                <Setter Property="Foreground" Value="#45475A" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                        <Setter Property="Text" Value="Playing" />
                                        <Setter Property="Foreground" Value="#A6E3A1" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsPaused}" Value="True">
                                        <Setter Property="Text" Value="Paused" />
                                        <Setter Property="Foreground" Value="#F9E2AF" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
