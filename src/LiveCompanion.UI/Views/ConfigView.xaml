<UserControl x:Class="LiveCompanion.UI.Views.ConfigView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#181825">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28,24">
        <StackPanel Margin="28,24">

            <!-- Page title -->
            <TextBlock Text="Configuration"
                       Foreground="#CDD6F4"
                       FontSize="26"
                       FontWeight="Bold"
                       Margin="0,0,0,20" />

            <!-- ============================================================ -->
            <!-- AUDIO SECTION                                                -->
            <!-- ============================================================ -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="CONFIGURATION AUDIO"
                               Style="{StaticResource SectionHeader}" />

                    <!-- ASIO Driver -->
                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Driver ASIO"
                                   Style="{StaticResource FieldLabel}" />
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding AvailableDrivers}"
                                  SelectedItem="{Binding SelectedDriver}"
                                  Style="{StaticResource ConfigComboStyle}" />
                    </Grid>

                    <!-- Buffer Size -->
                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Buffer Size"
                                   Style="{StaticResource FieldLabel}" />
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding AvailableBufferSizes}"
                                  SelectedItem="{Binding SelectedBufferSize}"
                                  Style="{StaticResource ConfigComboStyle}" />
                    </Grid>

                    <!-- Bus Mappings -->
                    <TextBlock Text="Bus → Sorties"
                               Foreground="#A6ADC8"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Margin="0,12,0,6" />

                    <ItemsControl ItemsSource="{Binding BusMappings}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding BusName}"
                                               Foreground="#CDD6F4"
                                               FontSize="13"
                                               VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1"
                                               Text="→"
                                               Foreground="#585B70"
                                               FontSize="13"
                                               Margin="8,0"
                                               VerticalAlignment="Center" />
                                    <ComboBox Grid.Column="2"
                                              ItemsSource="{Binding DataContext.AvailableOutputPairs, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                              SelectedItem="{Binding OutputName}"
                                              IsEditable="True"
                                              Style="{StaticResource ConfigComboStyle}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Apply Audio button -->
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="Appliquer Audio"
                                Command="{Binding ApplyAudioConfigCommand}"
                                Style="{StaticResource ActionButtonStyle}" />

                        <TextBlock Text="{Binding AudioStatusMessage}"
                                   Foreground="#A6E3A1"
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   Margin="8,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ============================================================ -->
            <!-- MIDI SECTION                                                 -->
            <!-- ============================================================ -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="CONFIGURATION MIDI"
                                   Style="{StaticResource SectionHeader}" />
                        <TextBlock Grid.Column="1"
                                   Foreground="#6C7086"
                                   FontSize="11"
                                   VerticalAlignment="Center"
                                   Margin="0,0,0,12">
                            <Run Text="{Binding SelectedMidiPortCount, Mode=OneWay}" />
                            <Run Text="/ 6 ports" />
                        </TextBlock>
                    </Grid>

                    <TextBlock Text="Sélectionnez jusqu'à 6 ports MIDI OUT :"
                               Foreground="#A6ADC8"
                               FontSize="13"
                               Margin="0,0,0,8" />

                    <!-- MIDI port list -->
                    <ItemsControl ItemsSource="{Binding AvailableMidiPorts}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ToggleButton Content="{Binding PortName}"
                                              IsChecked="{Binding IsSelected}"
                                              Style="{StaticResource MidiPortToggleStyle}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- MIDI buttons -->
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="Appliquer MIDI"
                                Command="{Binding ApplyMidiConfigCommand}"
                                Style="{StaticResource ActionButtonStyle}" />

                        <Button Content="Test Send"
                                Command="{Binding TestMidiSendCommand}"
                                Style="{StaticResource ActionButtonStyle}" />
                    </StackPanel>

                    <!-- MIDI status -->
                    <TextBlock Text="{Binding MidiStatusMessage}"
                               Foreground="#F9E2AF"
                               FontSize="12"
                               Margin="0,8,0,0" />

                    <!-- Test result -->
                    <TextBlock Text="{Binding MidiTestResult}"
                               Foreground="#89B4FA"
                               FontSize="12"
                               Margin="0,4,0,0" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
