<UserControl x:Class="LiveCompanion.UI.Views.EditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#181825">

    <UserControl.Resources>
        <!-- TabItem style override for this view -->
        <Style TargetType="TabItem" BasedOn="{StaticResource DarkTabItemStyle}" />
    </UserControl.Resources>

    <Grid Margin="28,24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ============================================================ -->
        <!-- LEFT PANEL: Song library                                     -->
        <!-- ============================================================ -->
        <Border Grid.Column="0" Style="{StaticResource CardStyle}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top"
                           Text="MORCEAUX"
                           Style="{StaticResource SectionHeader}" />

                <!-- Create new song -->
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                    <TextBox Text="{Binding NewSongTitle, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource EditorTextBoxStyle}"
                             Margin="0,0,0,6" />
                    <Button Content="+ Nouveau morceau"
                            Command="{Binding CreateSongCommand}"
                            Style="{StaticResource AccentButtonStyle}"
                            HorizontalAlignment="Stretch" />
                </StackPanel>

                <!-- Delete selected song -->
                <Button DockPanel.Dock="Bottom"
                        Content="Supprimer"
                        Command="{Binding DeleteSongCommand}"
                        Style="{StaticResource ActionButtonStyle}"
                        Foreground="#F38BA8"
                        HorizontalAlignment="Stretch"
                        Margin="0,8,0,0" />

                <!-- Song list -->
                <ListBox ItemsSource="{Binding Songs}"
                         SelectedItem="{Binding SelectedSong}"
                         Background="Transparent"
                         BorderThickness="0"
                         ItemContainerStyle="{StaticResource EditorListItemStyle}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding Title}"
                                           Foreground="#CDD6F4"
                                           FontSize="14"
                                           FontWeight="Medium" />
                                <TextBlock Foreground="#585B70" FontSize="11">
                                    <Run Text="{Binding Sections.Count, Mode=OneWay}" />
                                    <Run Text="sections" />
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- ============================================================ -->
        <!-- RIGHT PANEL: Tabbed editor                                   -->
        <!-- ============================================================ -->
        <DockPanel Grid.Column="2">

            <!-- Song title + Save -->
            <Border DockPanel.Dock="Top" Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Titre :"
                               Style="{StaticResource FieldLabel}"
                               FontSize="16" />
                    <TextBox Grid.Column="1"
                             Text="{Binding SelectedSong.Title, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource EditorTextBoxStyle}"
                             FontSize="16"
                             FontWeight="SemiBold" />
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button Content="Sauvegarder"
                                Command="{Binding SaveSongCommand}"
                                Style="{StaticResource AccentButtonStyle}"
                                Margin="12,0,4,0" />
                        <Button Content="Exporter .json"
                                Command="{Binding SaveSongToDiskCommand}"
                                Style="{StaticResource ActionButtonStyle}"
                                Margin="0" />
                        <Button Content="Charger .json"
                                Command="{Binding LoadSongFromDiskCommand}"
                                Style="{StaticResource ActionButtonStyle}"
                                Margin="4,0,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Status message -->
            <TextBlock DockPanel.Dock="Top"
                       Text="{Binding StatusMessage}"
                       Foreground="#A6E3A1"
                       FontSize="12"
                       Margin="0,4,0,0" />

            <!-- ======================================================== -->
            <!-- TABS: Sections / Samples / MIDI / Click                  -->
            <!-- ======================================================== -->
            <TabControl Background="Transparent"
                        BorderThickness="0"
                        Margin="0,8,0,0">

                <!-- ================================================== -->
                <!-- SECTIONS TAB                                       -->
                <!-- ================================================== -->
                <TabItem Header="Sections">
                    <DockPanel Margin="0,8,0,0">
                        <!-- Section action bar -->
                        <Border DockPanel.Dock="Top" Style="{StaticResource CardStyle}" Padding="20,8">
                            <DockPanel>
                                <Button Content="Import MIDI"
                                        Command="{Binding ImportFromMidiCommand}"
                                        Style="{StaticResource AccentButtonStyle}"
                                        DockPanel.Dock="Left" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="+ Ajouter"
                                            Command="{Binding AddSectionCommand}"
                                            Style="{StaticResource ActionButtonStyle}" />
                                    <Button Content="Supprimer"
                                            Command="{Binding RemoveSectionCommand}"
                                            Style="{StaticResource ActionButtonStyle}"
                                            Foreground="#F38BA8" />
                                    <Button Content="&#x25B2; Monter"
                                            Command="{Binding MoveSectionUpCommand}"
                                            Style="{StaticResource ActionButtonStyle}" />
                                    <Button Content="&#x25BC; Descendre"
                                            Command="{Binding MoveSectionDownCommand}"
                                            Style="{StaticResource ActionButtonStyle}" />
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!-- Section list + Detail -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                                <ListBox x:Name="SectionsListBox"
                                         ItemsSource="{Binding Sections}"
                                         SelectedItem="{Binding SelectedSection}"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         AllowDrop="True"
                                         ItemContainerStyle="{StaticResource EditorListItemStyle}"
                                         PreviewMouseLeftButtonDown="SectionsListBox_PreviewMouseLeftButtonDown"
                                         PreviewMouseMove="SectionsListBox_PreviewMouseMove"
                                         Drop="SectionsListBox_Drop"
                                         DragOver="SectionsListBox_DragOver">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Name}"
                                                       Foreground="#CDD6F4" FontSize="13" />
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Border>

                            <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                                <StackPanel DataContext="{Binding SelectedSection}">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DataContext.SelectedSection,
                                                    RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>

                                    <TextBlock Text="NOM" Style="{StaticResource SectionHeader}" />
                                    <TextBox Text="{Binding Name,
                                                    UpdateSourceTrigger=PropertyChanged,
                                                    ValidatesOnNotifyDataErrors=True}"
                                             Style="{StaticResource EditorTextBoxStyle}"
                                             Margin="0,0,0,16" />

                                    <TextBlock Text="TEMPO (BPM)" Style="{StaticResource SectionHeader}" />
                                    <TextBox Text="{Binding Tempo,
                                                    UpdateSourceTrigger=LostFocus,
                                                    ValidatesOnNotifyDataErrors=True,
                                                    StringFormat={}{0:0.#}}"
                                             Style="{StaticResource EditorTextBoxStyle}"
                                             Margin="0,0,0,16" />

                                    <TextBlock Text="NOMBRE DE MESURES" Style="{StaticResource SectionHeader}" />
                                    <TextBox Text="{Binding BarCount,
                                                    UpdateSourceTrigger=LostFocus,
                                                    ValidatesOnNotifyDataErrors=True}"
                                             Style="{StaticResource EditorTextBoxStyle}"
                                             Margin="0,0,0,16" />

                                    <TextBlock Text="SIGNATURE RYTHMIQUE" Style="{StaticResource SectionHeader}" />
                                    <StackPanel Orientation="Horizontal">
                                        <ComboBox ItemsSource="{Binding DataContext.AvailableNumerators,
                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  SelectedItem="{Binding TimeSignatureNumerator}"
                                                  Style="{StaticResource EditorComboStyle}" />
                                        <TextBlock Text="/"
                                                   Foreground="#585B70" FontSize="16"
                                                   Margin="8,0" VerticalAlignment="Center" />
                                        <ComboBox ItemsSource="{Binding DataContext.AvailableDenominators,
                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  SelectedItem="{Binding TimeSignatureDenominator}"
                                                  Style="{StaticResource EditorComboStyle}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </DockPanel>
                </TabItem>

                <!-- ================================================== -->
                <!-- SAMPLES TAB                                        -->
                <!-- ================================================== -->
                <TabItem Header="Samples">
                    <DockPanel Margin="0,8,0,0">
                        <Border DockPanel.Dock="Top" Style="{StaticResource CardStyle}" Padding="20,8">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="+ Ajouter"
                                        Command="{Binding AddAudioClipCommand}"
                                        Style="{StaticResource ActionButtonStyle}" />
                                <Button Content="Supprimer"
                                        Command="{Binding RemoveAudioClipCommand}"
                                        Style="{StaticResource ActionButtonStyle}"
                                        Foreground="#F38BA8" />
                            </StackPanel>
                        </Border>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Sample list -->
                            <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                                <ListBox ItemsSource="{Binding AudioClips}"
                                         SelectedItem="{Binding SelectedAudioClip}"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         ItemContainerStyle="{StaticResource EditorListItemStyle}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}"
                                                           Foreground="#CDD6F4" FontSize="13" />
                                                <TextBlock Text="{Binding DisplaySummary}"
                                                           Foreground="#585B70" FontSize="11" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Border>

                            <!-- Sample detail -->
                            <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel DataContext="{Binding SelectedAudioClip}">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DataContext.SelectedAudioClip,
                                                        RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>

                                        <!-- Name -->
                                        <TextBlock Text="NOM" Style="{StaticResource SectionHeader}" />
                                        <TextBox Text="{Binding Name,
                                                        UpdateSourceTrigger=PropertyChanged,
                                                        ValidatesOnNotifyDataErrors=True}"
                                                 Style="{StaticResource EditorTextBoxStyle}"
                                                 Margin="0,0,0,12" />

                                        <!-- Audio file -->
                                        <TextBlock Text="FICHIER AUDIO" Style="{StaticResource SectionHeader}" />
                                        <DockPanel Margin="0,0,0,12">
                                            <Button DockPanel.Dock="Right"
                                                    Content="Parcourir..."
                                                    Command="{Binding DataContext.BrowseAudioClipFileCommand,
                                                        RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    Style="{StaticResource ActionButtonStyle}"
                                                    MinWidth="90" Margin="8,0,0,0" />
                                            <TextBox Text="{Binding FilePath, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource EditorTextBoxStyle}"
                                                     IsReadOnly="True" />
                                        </DockPanel>

                                        <!-- Sends -->
                                        <DockPanel Margin="0,0,0,4">
                                            <TextBlock Text="SENDS" Style="{StaticResource SectionHeader}"
                                                       DockPanel.Dock="Left" VerticalAlignment="Center" />
                                            <Button Content="+ Send"
                                                    Command="{Binding AddSendCommand}"
                                                    Style="{StaticResource ActionButtonStyle}"
                                                    DockPanel.Dock="Right"
                                                    HorizontalAlignment="Right"
                                                    MinWidth="70"
                                                    FontSize="11" />
                                        </DockPanel>
                                        <ItemsControl ItemsSource="{Binding Sends}" Margin="0,0,0,12">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="#262637" CornerRadius="8"
                                                            Padding="10,6" Margin="0,3">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="90" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="45" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>

                                                            <TextBox Grid.Column="0"
                                                                     Text="{Binding BusName, UpdateSourceTrigger=PropertyChanged}"
                                                                     Style="{StaticResource EditorTextBoxStyle}"
                                                                     FontSize="12" />

                                                            <Slider Grid.Column="1"
                                                                    Value="{Binding Volume}"
                                                                    Minimum="0" Maximum="1"
                                                                    TickFrequency="0.01"
                                                                    IsSnapToTickEnabled="False"
                                                                    VerticalAlignment="Center"
                                                                    Margin="8,0" />

                                                            <TextBlock Grid.Column="2"
                                                                       Text="{Binding Volume, StringFormat={}{0:0.00}}"
                                                                       Foreground="#A6ADC8"
                                                                       FontSize="12"
                                                                       VerticalAlignment="Center"
                                                                       HorizontalAlignment="Right" />

                                                            <Button Grid.Column="3"
                                                                    Content="x"
                                                                    Command="{Binding DataContext.RemoveSendCommand,
                                                                        RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                    CommandParameter="{Binding}"
                                                                    Foreground="#F38BA8"
                                                                    Background="Transparent"
                                                                    BorderThickness="0"
                                                                    FontSize="14"
                                                                    Cursor="Hand"
                                                                    Margin="6,0,0,0"
                                                                    VerticalAlignment="Center" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!-- Fades -->
                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="12" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="FADE-IN (s)" Style="{StaticResource SectionHeader}" />
                                                <TextBox Text="{Binding FadeInSeconds,
                                                                UpdateSourceTrigger=LostFocus,
                                                                ValidatesOnNotifyDataErrors=True,
                                                                StringFormat={}{0:0.##}}"
                                                         Style="{StaticResource EditorTextBoxStyle}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="FADE-OUT (s)" Style="{StaticResource SectionHeader}" />
                                                <TextBox Text="{Binding FadeOutSeconds,
                                                                UpdateSourceTrigger=LostFocus,
                                                                ValidatesOnNotifyDataErrors=True,
                                                                StringFormat={}{0:0.##}}"
                                                         Style="{StaticResource EditorTextBoxStyle}" />
                                            </StackPanel>
                                        </Grid>

                                        <!-- Sync mode -->
                                        <TextBlock Text="MODE DE SYNCHRONISATION" Style="{StaticResource SectionHeader}" />
                                        <ComboBox ItemsSource="{Binding DataContext.AvailableSyncModes,
                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  SelectedItem="{Binding SyncMode}"
                                                  Style="{StaticResource EditorComboStyle}"
                                                  MinWidth="140"
                                                  Margin="0,0,0,12" />

                                        <!-- Position -->
                                        <TextBlock Text="POSITION (Section / Mesure / Temps / Tick)" Style="{StaticResource SectionHeader}" />
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                            <ComboBox ItemsSource="{Binding DataContext.Sections,
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                      DisplayMemberPath="Name"
                                                      SelectedIndex="{Binding SectionIndex}"
                                                      Style="{StaticResource EditorComboStyle}"
                                                      MinWidth="120" Margin="0,0,6,0" />
                                            <TextBlock Text="/" Foreground="#585B70" FontSize="16"
                                                       Margin="0,0,6,0" VerticalAlignment="Center" />
                                            <TextBox Text="{Binding Bar,
                                                            UpdateSourceTrigger=LostFocus,
                                                            ValidatesOnNotifyDataErrors=True}"
                                                     Style="{StaticResource EditorTextBoxStyle}"
                                                     Width="60" Margin="0,0,6,0" />
                                            <TextBlock Text="/" Foreground="#585B70" FontSize="16"
                                                       Margin="0,0,6,0" VerticalAlignment="Center" />
                                            <TextBox Text="{Binding Beat,
                                                            UpdateSourceTrigger=LostFocus,
                                                            ValidatesOnNotifyDataErrors=True}"
                                                     Style="{StaticResource EditorTextBoxStyle}"
                                                     Width="60" Margin="0,0,6,0" />
                                            <TextBlock Text="/" Foreground="#585B70" FontSize="16"
                                                       Margin="0,0,6,0" VerticalAlignment="Center" />
                                            <TextBox Text="{Binding Tick,
                                                            UpdateSourceTrigger=LostFocus,
                                                            ValidatesOnNotifyDataErrors=True}"
                                                     Style="{StaticResource EditorTextBoxStyle}"
                                                     Width="60" />
                                        </StackPanel>
                                    </StackPanel>
                                </ScrollViewer>
                            </Border>
                        </Grid>
                    </DockPanel>
                </TabItem>

                <!-- ================================================== -->
                <!-- MIDI TAB                                           -->
                <!-- ================================================== -->
                <TabItem Header="MIDI">
                    <DockPanel Margin="0,8,0,0">
                        <Border DockPanel.Dock="Top" Style="{StaticResource CardStyle}" Padding="20,8">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="+ Ajouter"
                                        Command="{Binding AddMidiEventCommand}"
                                        Style="{StaticResource ActionButtonStyle}" />
                                <Button Content="Supprimer"
                                        Command="{Binding RemoveMidiEventCommand}"
                                        Style="{StaticResource ActionButtonStyle}"
                                        Foreground="#F38BA8" />
                                <Button Content="Test"
                                        Command="{Binding TestMidiEventCommand}"
                                        Style="{StaticResource AccentButtonStyle}" />
                            </StackPanel>
                        </Border>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- MIDI event list -->
                            <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                                <ListBox ItemsSource="{Binding MidiEvents}"
                                         SelectedItem="{Binding SelectedMidiEvent}"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         ItemContainerStyle="{StaticResource EditorListItemStyle}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding DisplaySummary}"
                                                       Foreground="#CDD6F4" FontSize="13" />
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Border>

                            <!-- MIDI event detail -->
                            <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel DataContext="{Binding SelectedMidiEvent}">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DataContext.SelectedMidiEvent,
                                                        RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>

                                        <!-- Type -->
                                        <TextBlock Text="TYPE" Style="{StaticResource SectionHeader}" />
                                        <ComboBox ItemsSource="{Binding DataContext.AvailableMidiEventTypes,
                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  SelectedItem="{Binding Type}"
                                                  Style="{StaticResource EditorComboStyle}"
                                                  MinWidth="160"
                                                  Margin="0,0,0,12" />

                                        <!-- Device Out -->
                                        <TextBlock Text="DEVICE MIDI OUT" Style="{StaticResource SectionHeader}" />
                                        <ComboBox ItemsSource="{Binding DataContext.AvailableMidiPorts,
                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  SelectedItem="{Binding DeviceOut}"
                                                  Style="{StaticResource EditorComboStyle}"
                                                  MinWidth="200"
                                                  Margin="0,0,0,12" />

                                        <!-- Channel -->
                                        <TextBlock Text="CANAL MIDI (1-16)" Style="{StaticResource SectionHeader}" />
                                        <TextBox Text="{Binding Channel,
                                                        UpdateSourceTrigger=LostFocus,
                                                        ValidatesOnNotifyDataErrors=True}"
                                                 Style="{StaticResource EditorTextBoxStyle}"
                                                 Width="80" HorizontalAlignment="Left"
                                                 Margin="0,0,0,12" />

                                        <!-- Data1 -->
                                        <TextBlock Text="DATA 1 (0-127)" Style="{StaticResource SectionHeader}" />
                                        <TextBox Text="{Binding Data1,
                                                        UpdateSourceTrigger=LostFocus,
                                                        ValidatesOnNotifyDataErrors=True}"
                                                 Style="{StaticResource EditorTextBoxStyle}"
                                                 Width="80" HorizontalAlignment="Left"
                                                 Margin="0,0,0,12" />

                                        <!-- Data2 (hidden for ProgramChange) -->
                                        <StackPanel Visibility="{Binding ShowData2,
                                                        Converter={StaticResource BoolToVis}}"
                                                    Margin="0,0,0,12">
                                            <TextBlock Text="DATA 2 (0-127)" Style="{StaticResource SectionHeader}" />
                                            <TextBox Text="{Binding Data2,
                                                            UpdateSourceTrigger=LostFocus,
                                                            ValidatesOnNotifyDataErrors=True}"
                                                     Style="{StaticResource EditorTextBoxStyle}"
                                                     Width="80" HorizontalAlignment="Left" />
                                        </StackPanel>

                                        <!-- Position -->
                                        <TextBlock Text="POSITION (Section / Mesure / Temps / Tick)" Style="{StaticResource SectionHeader}" />
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                            <ComboBox ItemsSource="{Binding DataContext.Sections,
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                      DisplayMemberPath="Name"
                                                      SelectedIndex="{Binding SectionIndex}"
                                                      Style="{StaticResource EditorComboStyle}"
                                                      MinWidth="120" Margin="0,0,6,0" />
                                            <TextBlock Text="/" Foreground="#585B70" FontSize="16"
                                                       Margin="0,0,6,0" VerticalAlignment="Center" />
                                            <TextBox Text="{Binding Bar,
                                                            UpdateSourceTrigger=LostFocus,
                                                            ValidatesOnNotifyDataErrors=True}"
                                                     Style="{StaticResource EditorTextBoxStyle}"
                                                     Width="60" Margin="0,0,6,0" />
                                            <TextBlock Text="/" Foreground="#585B70" FontSize="16"
                                                       Margin="0,0,6,0" VerticalAlignment="Center" />
                                            <TextBox Text="{Binding Beat,
                                                            UpdateSourceTrigger=LostFocus,
                                                            ValidatesOnNotifyDataErrors=True}"
                                                     Style="{StaticResource EditorTextBoxStyle}"
                                                     Width="60" Margin="0,0,6,0" />
                                            <TextBlock Text="/" Foreground="#585B70" FontSize="16"
                                                       Margin="0,0,6,0" VerticalAlignment="Center" />
                                            <TextBox Text="{Binding Tick,
                                                            UpdateSourceTrigger=LostFocus,
                                                            ValidatesOnNotifyDataErrors=True}"
                                                     Style="{StaticResource EditorTextBoxStyle}"
                                                     Width="60" />
                                        </StackPanel>
                                    </StackPanel>
                                </ScrollViewer>
                            </Border>
                        </Grid>
                    </DockPanel>
                </TabItem>

                <!-- ================================================== -->
                <!-- CLICK TAB                                          -->
                <!-- ================================================== -->
                <TabItem Header="Clic">
                    <Border Margin="0,8,0,0" Style="{StaticResource CardStyle}">
                        <StackPanel MaxWidth="500" HorizontalAlignment="Left">
                            <TextBlock Text="PISTE DE CLIC" Style="{StaticResource SectionHeader}" />
                            <TextBlock Foreground="#A6ADC8" FontSize="12" Margin="0,0,0,16"
                                       TextWrapping="Wrap">
                                Associez un fichier audio comme piste de clic.
                                Il sera routé vers le bus "Click" lors de la lecture.
                            </TextBlock>

                            <!-- Selected file -->
                            <DockPanel Margin="0,0,0,12">
                                <Button DockPanel.Dock="Right"
                                        Content="Parcourir..."
                                        Command="{Binding BrowseClickTrackCommand}"
                                        Style="{StaticResource ActionButtonStyle}"
                                        MinWidth="100" Margin="8,0,0,0" />
                                <Button DockPanel.Dock="Right"
                                        Content="Retirer"
                                        Command="{Binding ClearClickTrackCommand}"
                                        Style="{StaticResource ActionButtonStyle}"
                                        Foreground="#F38BA8"
                                        MinWidth="80" Margin="8,0,0,0" />
                                <TextBox Text="{Binding ClickTrackPath, Mode=OneWay}"
                                         Style="{StaticResource EditorTextBoxStyle}"
                                         IsReadOnly="True" />
                            </DockPanel>

                            <!-- File name display -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="Fichier :" Style="{StaticResource FieldLabel}" />
                                <TextBlock Foreground="#CDD6F4" FontSize="14" FontWeight="Medium"
                                           VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="{Binding ClickTrackFileName}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ClickTrackFileName}" Value="{x:Null}">
                                                    <Setter Property="Text" Value="Aucun" />
                                                    <Setter Property="Foreground" Value="#585B70" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>

                            <!-- Assigned bus -->
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Bus :" Style="{StaticResource FieldLabel}" />
                                <TextBlock Text="Click" Foreground="#89B4FA" FontSize="14"
                                           FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </TabItem>
            </TabControl>
        </DockPanel>
    </Grid>
</UserControl>
