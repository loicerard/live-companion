<UserControl x:Class="LiveCompanion.UI.Views.LibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#181825">

    <Grid Margin="28,24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ============================================================ -->
        <!-- Left column: SONGS                                           -->
        <!-- ============================================================ -->
        <Border Grid.Column="0" Style="{StaticResource CardStyle}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top"
                           Text="MORCEAUX"
                           Style="{StaticResource SectionHeader}" />

                <!-- Search bar -->
                <TextBox DockPanel.Dock="Top"
                         Text="{Binding SearchFilter, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource EditorTextBoxStyle}"
                         Margin="0,0,0,8">
                    <TextBox.Tag>Rechercher...</TextBox.Tag>
                </TextBox>

                <!-- Create bar -->
                <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0"
                             Text="{Binding NewSongTitle, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource EditorTextBoxStyle}"
                             Margin="0,0,8,0" />
                    <Button Grid.Column="1"
                            Content="Créer"
                            Command="{Binding CreateSongCommand}"
                            Style="{StaticResource AccentButtonStyle}" />
                </Grid>

                <!-- Action buttons -->
                <WrapPanel DockPanel.Dock="Bottom"
                           Margin="0,8,0,0">
                    <Button Content="Supprimer"
                            Command="{Binding DeleteSongCommand}"
                            Style="{StaticResource ActionButtonStyle}" />
                    <Button Content="Ajouter à playlist"
                            Command="{Binding AddToPlaylistCommand}"
                            Style="{StaticResource AccentButtonStyle}" />
                    <Button Content="Exporter .json"
                            Command="{Binding ExportSongCommand}"
                            Style="{StaticResource ActionButtonStyle}" />
                    <Button Content="Importer .json"
                            Command="{Binding ImportSongCommand}"
                            Style="{StaticResource ActionButtonStyle}" />
                    <Button Content="Exporter tout"
                            Command="{Binding ExportAllSongsCommand}"
                            Style="{StaticResource ActionButtonStyle}" />
                    <Button Content="Importer tout"
                            Command="{Binding ImportAllSongsCommand}"
                            Style="{StaticResource ActionButtonStyle}" />
                </WrapPanel>

                <!-- Status -->
                <TextBlock DockPanel.Dock="Bottom"
                           Text="{Binding StatusMessage}"
                           Foreground="#A6ADC8"
                           FontSize="11"
                           Margin="0,6,0,0" />

                <!-- Song list -->
                <ListBox ItemsSource="{Binding FilteredSongs}"
                         SelectedItem="{Binding SelectedSong}"
                         Background="Transparent"
                         BorderThickness="0"
                         ItemContainerStyle="{StaticResource LibraryListItemStyle}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding Title}"
                                           Foreground="White"
                                           FontSize="14"
                                           FontWeight="Bold" />
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Sections.Count, StringFormat={}{0} sections}"
                                               Foreground="#6C7086"
                                               FontSize="11" />
                                    <TextBlock Text=" — "
                                               Foreground="#6C7086"
                                               FontSize="11" />
                                    <TextBlock Text="{Binding LastModified, StringFormat={}{0:dd/MM/yyyy HH:mm}}"
                                               Foreground="#6C7086"
                                               FontSize="11" />
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- ============================================================ -->
        <!-- Right column: PLAYLISTS                                      -->
        <!-- ============================================================ -->
        <Border Grid.Column="2" Style="{StaticResource CardStyle}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top"
                           Text="PLAYLISTS"
                           Style="{StaticResource SectionHeader}" />

                <!-- Create playlist bar -->
                <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0"
                             Text="{Binding NewPlaylistName, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource EditorTextBoxStyle}"
                             Margin="0,0,8,0" />
                    <Button Grid.Column="1"
                            Content="Créer"
                            Command="{Binding CreatePlaylistCommand}"
                            Style="{StaticResource AccentButtonStyle}" />
                </Grid>

                <!-- Playlist list -->
                <ListBox DockPanel.Dock="Top"
                         ItemsSource="{Binding Playlists}"
                         SelectedItem="{Binding SelectedPlaylist}"
                         Background="Transparent"
                         BorderThickness="0"
                         MaxHeight="160"
                         ItemContainerStyle="{StaticResource LibraryListItemStyle}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding Name}"
                                           Foreground="White"
                                           FontSize="14"
                                           FontWeight="Bold" />
                                <TextBlock Text="{Binding SongIds.Count, StringFormat={}{0} morceau(x)}"
                                           Foreground="#6C7086"
                                           FontSize="11" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Playlist action buttons -->
                <WrapPanel DockPanel.Dock="Top"
                           Margin="0,4,0,8">
                    <Button Content="Supprimer playlist"
                            Command="{Binding DeletePlaylistCommand}"
                            Style="{StaticResource ActionButtonStyle}" />
                    <Button Content="Exporter playlists"
                            Command="{Binding ExportPlaylistsCommand}"
                            Style="{StaticResource ActionButtonStyle}" />
                    <Button Content="Importer playlists"
                            Command="{Binding ImportPlaylistsCommand}"
                            Style="{StaticResource ActionButtonStyle}" />
                </WrapPanel>

                <!-- Separator -->
                <Border DockPanel.Dock="Top"
                        Height="1"
                        Background="#2A2A3C"
                        Margin="0,4,0,12" />

                <!-- Playlist content -->
                <TextBlock DockPanel.Dock="Top"
                           Text="CONTENU DE LA PLAYLIST"
                           Style="{StaticResource SectionHeader}" />

                <!-- Management buttons -->
                <StackPanel DockPanel.Dock="Bottom"
                            Orientation="Horizontal"
                            Margin="0,8,0,0">
                    <Button Content="Retirer"
                            Command="{Binding RemoveFromPlaylistCommand}"
                            Style="{StaticResource ActionButtonStyle}" />
                    <Button Content="&#x25B2; Monter"
                            Command="{Binding MoveUpInPlaylistCommand}"
                            Style="{StaticResource ActionButtonStyle}" />
                    <Button Content="&#x25BC; Descendre"
                            Command="{Binding MoveDownInPlaylistCommand}"
                            Style="{StaticResource ActionButtonStyle}" />
                </StackPanel>

                <!-- Playlist songs -->
                <ListBox ItemsSource="{Binding PlaylistSongs}"
                         SelectedItem="{Binding SelectedPlaylistSong}"
                         Background="Transparent"
                         BorderThickness="0"
                         ItemContainerStyle="{StaticResource LibraryListItemStyle}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Title}"
                                       Foreground="#CDD6F4"
                                       FontSize="13" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
